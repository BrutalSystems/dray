# --- .dray/config.yaml
# Note carried over from the old config (_note):
# One repo, several services, one of them built from a shared repo.
name: shop
images:
  - name: shop-api
uses:
  - component: queue-service
    commit: abc1234
    as: queue
workloads:
  # Talks to queue over HTTP.
  - name: shop-api
    kind: deployment
    images:
      - shop-api
    manifests:
      - .k8s/api.yaml
    depends_on:
      - queue
    secrets:
      - shop-secrets
  - name: shop-worker
    kind: deployment
    images:
      - shop-api
    manifests:
      - .k8s/worker.yaml
    rollout_timeout: 15m0s
  - name: nightly
    kind: cronjob
    images:
      - shop-api
    manifests:
      - .k8s/nightly.yaml
  - name: queue
    kind: deployment
    images:
      - queue
    manifests:
      - .k8s/queue.yaml
    manual: true
  - name: old-thing
    kind: deployment
    images:
      - shop-api
    manifests:
      - .k8s/old.yaml
    disabled: true
  - name: search
    kind: deployment
    manifests:
      - .k8s/search.yaml
secrets:
  - name: shop-secrets
    from: secret:shop/shop-secrets

# --- registry entry
name: shop
repo: example/monorepo
environments:
  prod:
    target: main-cluster
    namespace: team-a
    namespace_mode: shared
    release: direct
    approval: none
    ci_required: true

# --- component queue-service
name: queue-service
repo: example/queue-service
kind: component
release_on: tag

# --- target main-cluster
name: main-cluster
cloud: aws
account: "111111111111"
region: us-east-2
cluster: main-cluster
profile: dev
platform: linux/arm64

# --- warnings
- images[0] shop-api: the mutable :latest tag is gone; workloads pin a digest (D4)
- images[0] shop-api: the cached deps image (shop-api:deps) is gone; BuildKit's layer cache replaces it. If the Dockerfile starts FROM shop-api:deps, switch it to a multi-stage build
- images[1] queue: was built from https://github.com/example/queue-service at "main"; pinned to the commit running today, abc1234 (D14)
- secrets: 1 secret(s) now come from the secret store; import their values with dray secrets import (D5)
- workloads[2] nightly: used :latest to track new builds; it now pins a digest and is redeployed with its image (D4)
- registry: the prod environment keeps today's behavior: namespace team-a marked shared (D15), direct apply, no approval. Tighten it once the app is on Dray
# --- validation
ok
