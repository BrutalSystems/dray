# --- .dray/config.yaml
name: shop-web
images:
  - name: shop-web
    repository: team-shop-web
    build_args:
      env_file: .env.production
      prefix: VITE_
    build_per_environment: true
workloads:
  - name: shop-web
    kind: deployment
    images:
      - shop-web
    manifests:
      - .k8s/web.yaml
pilets:
  names:
    - cart
    - orders
  command:
    - npm
    - run
    - publish:pilet
    - --
    - --pilet
    - '{name}'
  env: secret:shop-web/pilets
environments:
  prod:
    target: main-cluster
    namespace: team-a
    namespace_mode: shared
    release: direct
    approval: none
targets:
  main-cluster:
    cloud: aws
    account: "111111111111"
    region: us-east-2
    cluster: main-cluster
    platform: linux/arm64

# --- personal AWS profile
dev
# --- warnings
- images[0] shop-web: bakes environment settings in at build time, so it is rebuilt per environment instead of promoted (D13)
- pilets: publish values from secrets.env now come from secret:shop-web/pilets; import them with dray secrets import
- environments: the prod environment keeps today's behavior: namespace team-a marked shared (D15), direct apply, no approval. Give the app its own namespace and tighten it once it is on Dray
- defaults: the AWS profile dev is personal, so it is not in the repo; set it in your own Dray settings (aws_profiles) for account 111111111111
- secret_store: set secret_store: where the secret: references live
# --- validation
ok
